# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:8765

# Clerk (Backend API) — https://dashboard.clerk.com -> API Keys
# Server-only. Never send these to Flutter.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MSG91 — https://control.msg91.com -> API -> Auth Key
# Server-only.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
# Leave the above blank to run OTP send/verify in mock mode.

# Sarvam AI — https://dashboard.sarvam.ai -> API Keys
# Server-only. The app never receives this key; it calls this backend's
# /ai/* routes instead, and this backend calls Sarvam on the app's behalf.
SARVAM_API_KEY=

# Database (Supabase Postgres connection string)
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI, "Transaction" pooler for serverless, "Session" for long-lived servers)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
